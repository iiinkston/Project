{
  "name": "mjh-printer-client",
  "version": "1.0.1",
  "private": true,
  "description": "满江红打印助手 — Windows GUI Control Plane for MJH Printer Agent",
  "author": "满江红",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.json --noEmit && vite build",
    "preview": "vite preview",
    "electron:dev": "concurrently -k -n vite,electron -c cyan,magenta \"vite\" \"wait-on http://127.0.0.1:5173 && node scripts/start-electron.mjs\"",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "dist:win": "pnpm build && electron-builder --win --x64 --dir",
    "dist:setup": "pnpm build && node installer/stage-agent.mjs && electron-builder --win --x64",
    "dist:all": "pnpm dist:win && node installer/copy-client-artifact.mjs"
  },
  "dependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "electron": "^34.2.0",
    "electron-builder": "^25.1.8",
    "typescript": "^5.8.2",
    "vite": "^6.2.0",
    "wait-on": "^8.0.2"
  },
  "build": {
    "appId": "com.manjianghong.printer-client",
    "productName": "MJH Printer Client",
    "buildVersion": "1.0.1",
    "extraMetadata": {
      "version": "1.0.1"
    },
    "directories": {
      "output": "../dist/client-build"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "installer/agent-release",
        "to": "agent-release",
        "filter": ["**/*"]
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        }
      ],
      "signAndEditExecutable": false,
      "executableName": "MJH Printer Client"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": true,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "满江红打印助手",
      "runAfterFinish": true,
      "include": "installer/nsis-agent.nsh",
      "artifactName": "MJH Printer Setup.${ext}"
    },
    "asar": true,
    "publish": null,
    "electronDownload": {
      "mirror": "https://npmmirror.com/mirrors/electron/"
    }
  }
}
