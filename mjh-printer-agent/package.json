{
  "name": "mjh-printer-agent",
  "version": "1.0.0",
  "description": "MJH Printer Agent — outbound cloud print worker for Man Jiang Hong kitchen receipts",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx src/index.ts printer:test",
    "printer:test": "tsx src/index.ts printer:test",
    "agent:start": "tsx src/index.ts agent:start",
    "typecheck": "tsc --noEmit",
    "build": "tsc",
    "test": "tsx --test src/jobs/state-store.test.ts src/jobs/worker.test.ts src/printer/money.test.ts src/printer/receipt.test.ts"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "iconv-lite": "^0.6.3",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2"
  }
}
